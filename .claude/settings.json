{
  "agent": "coordinator",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(node scripts/*)",
      "Bash(gh repo clone *)",
      "Bash(gh repo view *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(node scripts/kb.mjs confirm *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard.mjs\""
          }
        ]
      }
    ]
  }
}

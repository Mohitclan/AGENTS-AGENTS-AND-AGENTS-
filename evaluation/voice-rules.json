  "flag": {
    "leverage": "use (fine as a noun)",
    "solution": "name the thing",
    "journey": "process or steps",
    "stakeholders": "name the people",
    "facilitate": "help or run",
    "pain points": "name the problem",
    "ai-powered": "say what it does for the reader",
    "best practices": "say what to do",
    "value proposition": "say what they get"
  },
  "weak": ["very", "really", "just", "actually", "basically", "literally", "honestly", "frankly", "clearly", "obviously", "simply", "a lot", "kind of", "sort of"],
  "weakLimitPer100Words": 2,
  "_styleComment": "Warn-only settings, our own word lists. superlatives: claims that need a source (patterns for 'the only', 'leading' and '#1' are in lint-copy.mjs). tier1: warn on every use, with a plainer word. tier2: each entry is a word family written as forms joined by a slash; warn when tierClusterMin or more different families sit in one paragraph (underscore and beacon are here because they have literal technical senses). tier3: fine now and then, warn when they pass tier3LimitPercent of the words. These are style signals for the author and the evaluator, never proof of anything.",
  "superlatives": ["fastest", "number one", "number 1", "better than", "cheaper than"],
  "tier1": {
    "delve": "dig into, or look at",
    "delves": "digs into, or looks at",
    "delving": "digging into, or looking at",
    "delved": "dug into, or looked at",
    "tapestry": "mix, or name the parts",
    "realm": "area, or field",
    "embark": "start",
    "pivotal": "key, or say why it matters",
    "intricate": "detailed, or complex",
    "meticulous": "careful",
    "meticulously": "carefully",
    "vibrant": "say what it looks like",
    "bustling": "busy",
    "unleash": "release, or start",
    "elevate": "improve",
    "garner": "get",
    "plethora": "many",
    "myriad": "many",
    "multifaceted": "complex, or name the sides",
    "spearhead": "lead",
    "cornerstone": "base, or main part",
    "treasure trove": "name what is in it"
  },
  "tier2": [
    "robust", "comprehensive", "crucial", "vital", "innovative", "dynamic", "ecosystem", "landscape",
    "notably", "moreover", "furthermore", "additionally", "ultimately", "essentially", "nuanced",
    "harness/harnesses/harnessing/harnessed",
    "showcase/showcases/showcasing/showcased",
    "streamline/streamlines/streamlining/streamlined",
    "enhance/enhances/enhancing/enhanced",
    "navigate/navigates/navigating/navigated",
    "resonate/resonates/resonating/resonated",
    "underscore/underscores/underscored/underscoring",
    "beacon/beacons"
  ],
  "tierClusterMin": 2,
  "tier3": [
    "important", "significant", "significantly", "key", "various", "numerous", "effectively", "overall",
    "indeed", "particularly", "especially", "ensure", "ensures", "ensuring", "unique", "notable",
    "valuable", "critical", "essential", "effective"
  ],
  "tier3LimitPercent": 3,
  "emDashPer1000Words": 1,
  "_openerComment": "houseOpeners: how the email-template skill's first email opens (given by the human on 2026-11-10), so it passes even though it starts with \"I\". bannedOpeners still fail every other opener on the list.",
  "houseOpeners": ["i came across"],
  "bannedOpeners": [
    "i wanted to reach out", "i'm reaching out", "i am reaching out", "i noticed", "i saw",
    "we help companies like yours", "we help companies like", "my name is", "hope you", "hi there, i", "quick question"
  ],
  "sourceMarkers": ["source:", "sources:", "retrieved:", "observed:", "checked:", "evidence:", "told by", "http://", "https://", "knowledge/", "outputs/", "repos/", "[p:", "[c:"]
